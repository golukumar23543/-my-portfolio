rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolio/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /feedbacks/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /sessions/{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
